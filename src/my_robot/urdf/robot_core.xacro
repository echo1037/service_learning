<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. 虚拟接地基准点 (TF树的根节点) -->
    <!-- base_link 抬到：底盘半高 + 轮半径，使底盘底面刚好在轮心高度之上 -->
    <link name="base_footprint"/>
    <joint name="base_joint" type="fixed">
        <parent link="base_footprint"/>
        <child link="base_link"/>
        <origin xyz="0 0 ${chassis_height / 2 + wheel_radius}" rpy="0 0 0"/>
    </joint>

    <!-- 2. 底盘 Link -->
    <link name="base_link">
        <visual>
            <geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry>
            <material name="grey"><color rgba="0.5 0.5 0.5 1.0"/></material>
        </visual>
        <collision><geometry><box size="${chassis_length} ${chassis_width} ${chassis_height}"/></geometry></collision>
        <inertial>
            <!-- 只保留前万向轮时，质心略靠前，避免后仰压穿地面 -->
            <origin xyz="0.05 0 0" rpy="0 0 0"/>
            <mass value="5.0"/>
            <inertia ixx="0.01" ixy="0" ixz="0" iyy="0.01" iyz="0" izz="0.01"/>
        </inertial>
    </link>

    <!-- 3. 驱动轮宏 (左轮/右轮共用) -->
    <xacro:macro name="drive_wheel" params="prefix y_offset">
        <joint name="${prefix}_wheel_joint" type="continuous">
            <parent link="base_link"/>
            <child link="${prefix}_wheel_link"/>
            <!-- 轮心在底盘底面中心高度 → 相对地面高度 = wheel_radius -->
            <origin xyz="0 ${y_offset} ${-chassis_height / 2}" rpy="0 0 0"/>
            <axis xyz="0 1 0"/>
        </joint>
        <link name="${prefix}_wheel_link">
            <visual>
                <!-- 关键：把默认沿 Z 的圆柱转到沿 Y -->
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
                <material name="black">
                    <color rgba="0 0 0 1.0"/>
                </material>
            </visual>
            <collision>
                <origin xyz="0 0 0" rpy="1.5708 0 0"/>
                <geometry>
                    <cylinder radius="${wheel_radius}" length="${wheel_thickness}"/>
                </geometry>
            </collision>
            <inertial>
                <mass value="0.5"/>
                <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
            </inertial>
        </link>
        <!-- 驱动轮需要足够摩擦才能推动底盘沿 x 前进 -->
        <gazebo reference="${prefix}_wheel_link">
            <mu1>1.0</mu1>
            <mu2>1.0</mu2>
            <kp>1000000.0</kp>
            <kd>100.0</kd>
        </gazebo>
    </xacro:macro>

    <!-- 4. 万向轮宏 (前后万向轮共用) -->
    <!-- 半径略小于驱动轮，主要由驱动轮承重，万向轮只做支撑 -->
    <xacro:property name="caster_radius" value="0.03"/>
    <xacro:macro name="caster_wheel" params="prefix x_offset">
        <joint name="${prefix}_caster_joint" type="fixed">
            <parent link="base_link"/>
            <child link="${prefix}_caster_link"/>
            <!-- 球心略高于贴地高度，避免穿模；主要由驱动轮承重 -->
            <origin xyz="${x_offset} 0 ${-(chassis_height / 2 + wheel_radius - caster_radius - 0.005)}" rpy="0 0 0"/>
        </joint>
        <link name="${prefix}_caster_link">
            <visual>
                <geometry><sphere radius="${caster_radius}"/></geometry>
                <material name="black"/>
            </visual>
            <collision><geometry><sphere radius="${caster_radius}"/></geometry></collision>
            <inertial>
                <mass value="0.1"/>
                <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
            </inertial>
        </link>
        <!-- 低摩擦，便于差速转向时滑动 -->
        <gazebo reference="${prefix}_caster_link">
            <mu1>0.0</mu1>
            <mu2>0.0</mu2>
            <minDepth>0.001</minDepth>
            <maxContacts>2</maxContacts>
        </gazebo>
    </xacro:macro>

    <!-- 5. 实例化轮子：只保留前万向轮，去掉后万向轮 -->
    <xacro:drive_wheel prefix="left" y_offset="${chassis_width / 2 + wheel_thickness / 2}"/>
    <xacro:drive_wheel prefix="right" y_offset="${-(chassis_width / 2 + wheel_thickness / 2)}"/>
    <xacro:caster_wheel prefix="front" x_offset="${chassis_length / 2 - 0.05}"/>

</robot>
