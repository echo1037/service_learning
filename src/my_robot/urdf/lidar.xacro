<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

    <!-- 1. 激光雷达的固定关节 -->
    <joint name="lidar_joint" type="fixed">
        <parent link="base_link"/>
        <child link="lidar_link"/>
        <!-- 放置在底盘正上方，假设底盘高度为 chassis_height -->
        <origin xyz="0 0 ${chassis_height / 2 + 0.02}" rpy="0 0 0"/>
    </joint>

    <!-- 2. 激光雷达的物理连杆 (红色外观) -->
    <link name="lidar_link">
        <visual>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
            <material name="red">
                <color rgba="1.0 0.0 0.0 1.0"/> <!-- 纯红色 -->
            </material>
        </visual>
        <collision>
            <geometry>
                <cylinder radius="0.05" length="0.04"/>
            </geometry>
        </collision>
        <inertial>
            <mass value="0.1"/>
            <inertia ixx="0.001" ixy="0" ixz="0" iyy="0.001" iyz="0" izz="0.001"/>
        </inertial>
    </link>

    <!-- 3. Gazebo 激光雷达仿真插件 -->
    <gazebo reference="lidar_link">
        <!-- 告诉 Gazebo 渲染引擎使用内置的红色材质 -->
        <material>Gazebo/Red</material> 
        
        <sensor name="lidar_sensor" type="ray">
            <visualize>true</visualize> <!-- 在 Gazebo 中显示红色的激光射线 -->
            <update_rate>10</update_rate> <!-- 扫描频率 10Hz -->
            
            <ray>
                <scan>
                    <horizontal>
                        <samples>360</samples> <!-- 360度扫描 -->
                        <resolution>1</resolution>
                        <min_angle>-3.14159</min_angle>
                        <max_angle>3.14159</max_angle>
                    </horizontal>
                </scan>
                <range>
                    <min>0.1</min>  <!-- 最小探测距离 0.1米 -->
                    <max>10.0</max> <!-- 最大探测距离 10米 -->
                </range>
            </ray>
            
            <!-- 桥接到 ROS 2 话题 -->
            <plugin name="lidar_controller" filename="libgazebo_ros_ray_sensor.so">
                <ros>
                    <!-- 将雷达数据发布到 /scan 话题 -->
                    <remapping>~/out:=/scan</remapping>
                </ros>
                <output_type>sensor_msgs/LaserScan</output_type>
                <frame_name>lidar_link</frame_name>
            </plugin>
        </sensor>
    </gazebo>

</robot>