<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="my_robot">

  <!-- ================= 宏定义 (Macros) ================= -->
  
  <!-- 惯性矩阵计算宏 (假设均匀圆柱体) -->
  <xacro:macro name="cylinder_inertia" params="mass radius length">
    <inertial>
      <mass value="${mass}" />
      <inertia 
        ixx="${(1/12) * mass * (3*radius*radius + length*length)}" 
        ixy="0.0" ixz="0.0" 
        iyy="${(1/12) * mass * (3*radius*radius + length*length)}" 
        iyz="0.0" 
        izz="${(1/2) * mass * radius * radius}" />
    </inertial>
  </xacro:macro>

  <!-- 惯性矩阵计算宏 (假设均匀长方体) -->
  <xacro:macro name="box_inertia" params="mass x y z">
    <inertial>
      <mass value="${mass}" />
      <inertia 
        ixx="${(1/12) * mass * (y*y + z*z)}" 
        ixy="0.0" ixz="0.0" 
        iyy="${(1/12) * mass * (x*x + z*z)}" 
        iyz="0.0" 
        izz="${(1/12) * mass * (x*x + y*y)}" />
    </inertial>
  </xacro:macro>

  <!-- 驱动轮宏 -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel">
      <visual>
        <geometry>
          <cylinder radius="0.05" length="0.02" />
        </geometry>
        <material name="dark_grey" />
      </visual>
      <collision>
        <geometry>
          <cylinder radius="0.05" length="0.02" />
        </geometry>
      </collision>
      <xacro:cylinder_inertia mass="0.5" radius="0.05" length="0.02" />
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link" />
      <child link="${prefix}_wheel" />
      <origin xyz="0 ${reflect * 0.15} 0" rpy="${-pi/2} 0 0" />
      <axis xyz="0 0 1" />
      <dynamics damping="0.1" friction="0.1" />
    </joint>
  </xacro:macro>

  <!-- 万向轮宏 -->
  <xacro:macro name="caster_wheel" params="prefix x_offset">
    <link name="${prefix}_caster">
      <visual>
        <geometry>
          <sphere radius="0.03" />
        </geometry>
        <material name="black" />
      </visual>
      <collision>
        <geometry>
          <sphere radius="0.03" />
        </geometry>
      </collision>
      <inertial>
        <mass value="0.2" />
        <inertia 
          ixx="${(2/5) * 0.2 * 0.03 * 0.03}" ixy="0.0" ixz="0.0" 
          iyy="${(2/5) * 0.2 * 0.03 * 0.03}" iyz="0.0" 
          izz="${(2/5) * 0.2 * 0.03 * 0.03}" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="base_link" />
      <child link="${prefix}_caster" />
      <origin xyz="${x_offset} 0 -0.02" rpy="0 0 0" />
    </joint>
  </xacro:macro>

  <!-- ================= 材质定义 ================= -->
  <material name="blue"><color rgba="0.0 0.0 0.8 1.0" /></material>
  <material name="dark_grey"><color rgba="0.3 0.3 0.3 1.0" /></material>
  <material name="black"><color rgba="0.1 0.1 0.1 1.0" /></material>
  <material name="red"><color rgba="0.8 0.0 0.0 1.0" /></material>

  <!-- ================= 机器人本体 ================= -->

  <!-- 底盘 -->
  <link name="base_link">
    <visual>
      <geometry><box size="0.4 0.3 0.1" /></geometry>
      <material name="blue" />
    </visual>
    <collision>
      <geometry><box size="0.4 0.3 0.1" /></geometry>
    </collision>
    <xacro:box_inertia mass="5.0" x="0.4" y="0.3" z="0.1" />
  </link>

  <!-- 左右驱动轮 -->
  <xacro:drive_wheel prefix="left" reflect="1" />
  <xacro:drive_wheel prefix="right" reflect="-1" />

  <!-- 前后万向轮 -->
  <xacro:caster_wheel prefix="front" x_offset="0.15" />
  <xacro:caster_wheel prefix="rear" x_offset="-0.15" />

  <!-- 激光雷达支撑杆 -->
  <link name="lidar_pole">
    <visual>
      <geometry><cylinder radius="0.015" length="0.2" /></geometry>
      <material name="dark_grey" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.015" length="0.2" /></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.2" radius="0.015" length="0.2" />
  </link>
  <joint name="lidar_pole_joint" type="fixed">
    <parent link="base_link" /><child link="lidar_pole" />
    <origin xyz="0.1 0 0.15" rpy="0 0 0" />
  </joint>

  <!-- 激光雷达传感器 -->
  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.04" length="0.05" /></geometry>
      <material name="red" />
    </visual>
    <collision>
      <geometry><cylinder radius="0.04" length="0.05" /></geometry>
    </collision>
    <xacro:cylinder_inertia mass="0.3" radius="0.04" length="0.05" />
  </link>
  <joint name="lidar_joint" type="fixed">
    <parent link="lidar_pole" /><child link="lidar_link" />
    <origin xyz="0 0 0.125" rpy="0 0 0" />
  </joint>

  <!-- 相机传感器 -->
  <link name="camera_link">
    <visual>
      <geometry><box size="0.04 0.1 0.04" /></geometry>
      <material name="black" />
    </visual>
    <collision>
      <geometry><box size="0.04 0.1 0.04" /></geometry>
    </collision>
    <xacro:box_inertia mass="0.15" x="0.04" y="0.1" z="0.04" />
  </link>
  <joint name="camera_joint" type="fixed">
    <parent link="base_link" /><child link="camera_link" />
    <origin xyz="0.2 0 0.05" rpy="0 0 0" />
  </joint>

  <!-- 相机光学坐标系 -->
  <link name="camera_link_optical" />
  <joint name="camera_optical_joint" type="fixed">
    <parent link="camera_link" /><child link="camera_link_optical" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <!-- ================= Gazebo 扩展部分 (新增) ================= -->

  <!-- 1. 设置全局物理属性与颜色 -->
  <gazebo reference="base_link">
    <material>Gazebo/Blue</material>
  </gazebo>
  <gazebo reference="left_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1 value="1.0"/> <mu2 value="1.0"/>
  </gazebo>
  <gazebo reference="right_wheel">
    <material>Gazebo/DarkGrey</material>
    <mu1 value="1.0"/> <mu2 value="1.0"/>
  </gazebo>
  <gazebo reference="front_caster">
    <material>Gazebo/Black</material>
    <mu1 value="0.0"/> <mu2 value="0.0"/>
  </gazebo>
  <gazebo reference="rear_caster">
    <material>Gazebo/Black</material>
    <mu1 value="0.0"/> <mu2 value="0.0"/>
  </gazebo>
  <gazebo>
    <plugin name="diff_drive" filename="libgazebo_ros_diff_drive.so">
        <!-- 必须配置这个，否则机器人不知道听哪个话题 -->
        <commandTopic>cmd_vel</commandTopic> 
        
        <!-- 确认左右轮关节名与你 URDF 中定义的完全一致 -->
       
    </plugin>
  </gazebo>

  <!-- 2. 差速驱动控制器插件 (让机器人动起来) -->
  <gazebo>
    <plugin name="diff_drive_controller" filename="libgazebo_ros_diff_drive.so">
      <ros>
        <namespace>/</namespace>
        <remapping>cmd_vel:=cmd_vel</remapping>
        <remapping>odom:=odom</remapping>
      </ros>
      <update_rate>30</update_rate>
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>0.3</wheel_separation>
      <wheel_diameter>0.1</wheel_diameter>
      <max_wheel_torque>20</max_wheel_torque>
      <max_wheel_acceleration>1.0</max_wheel_acceleration>
      <publish_odom>true</publish_odom>
      <publish_odom_tf>true</publish_odom_tf>
      <publish_wheel_tf>true</publish_wheel_tf>
      <odometry_frame>odom</odometry_frame>
      <robot_base_frame>base_link</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- 3. 激光雷达插件 -->
  <gazebo reference="lidar_link">
    <sensor type="ray" name="head_hokuyo_sensor">
      <pose>0 0 0 0 0 0</pose>
      <visualize>false</visualize>
      <update_rate>40</update_rate>
      <ray>
        <scan>
          <horizontal>
            <samples>720</samples>
            <resolution>1</resolution>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.10</min>
          <max>30.0</max>
          <resolution>0.01</resolution>
        </range>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.01</stddev>
        </noise>
      </ray>
      <plugin name="gazebo_ros_head_hokuyo_controller" filename="libgazebo_ros_ray_sensor.so">
        <ros>
          <remapping>~/out:=scan</remapping>
        </ros>
        <output_type>sensor_msgs/LaserScan</output_type>
        <frame_name>lidar_link</frame_name>
      </plugin>
    </sensor>
  </gazebo>

  <!-- 4. 相机插件 -->
  <gazebo reference="camera_link">
    <sensor type="camera" name="camera1">
      <update_rate>30.0</update_rate>
      <camera name="head">
        <horizontal_fov>1.3962634</horizontal_fov>
        <image>
          <width>800</width>
          <height>800</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.02</near>
          <far>300</far>
        </clip>
        <noise>
          <type>gaussian</type>
          <mean>0.0</mean>
          <stddev>0.007</stddev>
        </noise>
      </camera>
      <plugin name="camera_controller" filename="libgazebo_ros_camera.so">
        <always_on>true</always_on>
        <update_rate>0.0</update_rate>
        <camera_name>camera</camera_name>
        <image_topic_name>image_raw</image_topic_name>
        <camera_info_topic_name>camera_info</camera_info_topic_name>
        <frame_name>camera_link_optical</frame_name>
        <hack_baseline>0.07</hack_baseline>
      </plugin>
    </sensor>
  </gazebo>

</robot>